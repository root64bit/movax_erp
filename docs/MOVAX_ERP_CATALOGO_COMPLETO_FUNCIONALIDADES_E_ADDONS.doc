<div class="Section1">

  <!-- CAPA CORPORATIVA -->
  <div class="cover">
    <div class="cover-title">MOVAX ERP / POS MULTI-TENANT</div>
    <div class="cover-subtitle">Manual Técnico & Catálogo Completo de Funcionalidades, Módulos e Add-ons SaaS</div>
    <div class="cover-meta">
      <strong>MM Global Techno Solutions, Lda.</strong> | Versão: 2.4.0 Enterprise<br>
      Mercado: Moçambique (Fiscalidade AT, Multimoeda, M-Pesa C2B e Offline-First)<br>
      Data de Emissão: Agosto de 2026
    </div>

# Production Supabase project (public browser configuration only)
VITE_SUPABASE_URL=https://bkbcgndzsfylwsinxwbb.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-project-anon-key

# Set to true only for isolated local UI development.
VITE_USE_MOCK_DATA=false

# Optional Stitch design-system project
VITE_STITCH_PROJECT_ID=replace-with-stitch-project-id
VITE_REPOSITORY_URL=

# Never add DATABASE_URL, database passwords, service-role keys, or access
# tokens to VITE_* variables. VITE_* values are bundled into browser code.
# Set to false to return instantly to the legacy full-loading method.
VITE_ENABLE_SELECTIVE_LOADING=true

# E2E test credentials (never commit real values)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CASHIER_EMAIL=
E2E_CASHIER_PASSWORD=
E2E_PRODUCT_SEARCH=
BASE_URL=http://127.0.0.1:4173
